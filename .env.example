# TaxKeep VN — Mobile FE
# Copy file này thành .env rồi chỉnh giá trị cho máy bạn:
#   copy .env.example .env
#
# Không commit file .env (đã nằm trong .gitignore).
# Chỉ commit .env.example để cả nhóm cùng một bộ khóa biến.

# API Backend (bắt buộc khi chạy FE)
# - Emulator Android: dùng 10.0.2.2 (trỏ về localhost của máy PC)
# - Máy thật / Expo Go cùng Wi‑Fi: dùng IP LAN của PC (ipconfig → IPv4), ví dụ 192.168.1.10
# - Web / iOS Simulator: có thể dùng localhost
# Local BE Management :5023 | Deploy Gateway ví dụ:
# EXPO_PUBLIC_API_URL=http://13.236.166.3:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5023

# (Tuỳ chọn) AI / OCR service — bỏ trống nếu chưa chạy TaxAI
# EXPO_PUBLIC_AI_URL=http://10.0.2.2:8000
