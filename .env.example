# API Backend / API Gateway (bắt buộc khi chạy FE)
# - Server đã deploy (API Gateway): http://13.236.166.3:5000
# - Emulator Android (local): dùng http://10.0.2.2:5023 (trỏ về localhost của máy PC)
# - Máy thật / Expo Go cùng Wi‑Fi (local): comment dòng này để Metro tự nhận IP LAN, hoặc điền http://192.168.x.x:5023
# - Web / iOS Simulator (local): có thể dùng http://localhost:5023
EXPO_PUBLIC_API_URL=http://13.236.166.3:5000

# (Tuỳ chọn) AI / OCR service — qua API Gateway đã deploy dùng /ai, hoặc local http://10.0.2.2:8000
EXPO_PUBLIC_AI_URL=http://13.236.166.3:5000/ai
